<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.naho.book.mybatis.LessonQueryMapper">

    <resultMap id="LessonResultMap" type="org.naho.book.entity.LessonEntity">
        <id property="id" column="id"/>
        <result property="createdTime" column="created_time"/>
        <result property="modifiedTime" column="modified_time"/>
        <result property="japaneseName" column="japanese_name"/>
        <result property="japaneseDescription" column="japanese_description"/>
        <result property="japaneseNameMarkup" column="japanese_name_markup"/>
        <result property="japaneseDescriptionMarkup" column="japanese_description_markup"/>
        <result property="status" column="status"/>
        <result property="orderIndex" column="order_index"/>
        <result property="firstNodeGlobalOrderIndex" column="first_node_global_order_index"/>
        <result property="lastNodeGlobalOrderIndex" column="last_node_global_order_index"/>
        <association property="topic" javaType="org.naho.book.entity.TopicEntity">
            <id property="id" column="topic_id"/>
        </association>
    </resultMap>

    <select id="findBySpeakingQuestionId" resultMap="LessonResultMap">
        select l.*
        from speaking_questions sq
                 join learning_path_nodes lpn on sq.id = lpn.speaking_question_id
                 join objectives o on lpn.objective_id = o.id
                 join lessons l on o.lesson_id = l.id
        where sq.id = #{speakingQuestionId}
    </select>
</mapper>