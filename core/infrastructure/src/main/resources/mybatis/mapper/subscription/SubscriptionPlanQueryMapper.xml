<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.naho.subscription.mybatis.SubscriptionPlanQueryMapper">
    <resultMap id="SubscriptionPlanResultMap" type="org.naho.subscription.entity.SubscriptionPlanEntity">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="description" column="description"/>
        <result property="tier" column="tier"/>
        <result property="priceAmount" column="price_amount"/>
        <result property="priceCurrency" column="price_currency"/>
        <result property="durationDays" column="duration_days"/>
        <result property="dailySpeakingQuestionEvaluationLimit" column="daily_speaking_question_evaluation_limit"/>
        <result property="maxSpeakingQuestionRecordingSeconds" column="max_speaking_question_recording_seconds"/>
        <result property="maxTurnsPerAiSession" column="max_turns_per_ai_session"/>
        <result property="dailyAiSessionStartLimit" column="daily_ai_session_start_limit"/>
        <result property="maxAiTurnSpeakingSeconds" column="max_ai_turn_speaking_seconds"/>
        <result property="sampleAnswerEnabled" column="sample_answer_enabled"/>
        <result property="status" column="status"/>
        <result property="createdTime" column="created_time"/>
        <result property="modifiedTime" column="modified_time"/>
    </resultMap>

    <select id="findCurrentSubscriptionPlanByUserIdAndStatus" resultMap="SubscriptionPlanResultMap">
        select sp.*
        from user_subscriptions us
                 join subscription_plans sp on us.subscription_plan_id = sp.id
        where us.user_id = #{userId}
          and us.status = #{subscriptionStatus}
          and sp.status = #{planStatus}
          and us.start_time &lt;= #{now}
          and us.end_time &gt;= #{now}
    </select>
</mapper>