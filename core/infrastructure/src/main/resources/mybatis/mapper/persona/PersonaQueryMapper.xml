<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.naho.persona.mybatis.PersonaQueryMapper">
    <resultMap id="PersonaEntityResultMap" type="org.naho.persona.entity.PersonaEntity">
        <id property="id" column="id"/>

        <result property="name" column="name"/>
        <result property="prompt" column="prompt"/>
        <result property="status" column="status"/>
        <result property="voiceName" column="voice_name"/>
        <result property="gender" column="gender"/>
        <result property="defaultMarugotoLevel" column="default_marugoto_level"/>
        <result property="defaultFormalityLevel" column="default_formality_level"/>

        <association property="avatarFile" javaType="org.naho.file.entity.FileEntity">
            <id property="id" column="avatar_file_id"/>
        </association>
    </resultMap>

    <select id="findBySessionCode" resultMap="PersonaEntityResultMap">
        select p.*
        from naho.personas p
                 join naho.speaking_sessions ss on p.id = ss.persona_id
        where ss.session_code = #{sessionCode}
    </select>
</mapper>
